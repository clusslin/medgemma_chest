# Application Settings
APP_NAME="MedGemma Chest X-Ray Automation"
APP_VERSION="1.0.0"
DEBUG=false
LOG_LEVEL=INFO

# Database Settings
DATABASE_URL=postgresql://postgres:password@postgres:5432/medgemma_chest
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# DICOM Settings
DICOM_AE_TITLE=MEDGEMMA_SCP
DICOM_PORT=11112
DICOM_HOST=0.0.0.0
DICOM_STORAGE_PATH=/app/data/dicom_storage

# MedGemma Model Settings
MODEL_NAME=google/medgemma-27b-it
MODEL_CACHE_DIR=/app/models
MODEL_DEVICE=cuda
MODEL_LOAD_IN_8BIT=true
MODEL_MAX_LENGTH=2048

# RabbitMQ Settings
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_QUEUE_DICOM=dicom_processing
RABBITMQ_QUEUE_REPORT=report_generation

# Redis Settings
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:8081"]

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# File Transfer Settings
FTP_ENABLED=false
FTP_HOST=
FTP_PORT=22
FTP_USER=
FTP_PASSWORD=
FTP_REMOTE_PATH=/reports

SSH_ENABLED=false
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_KEY_PATH=

# Result Classification Thresholds
THRESHOLD_NORMAL=0.8
THRESHOLD_ABNORMAL=0.6
THRESHOLD_CRITICAL=0.4
THRESHOLD_EMERGENCY=0.2

# Age Filter
MIN_AGE=20

# Allowed Study Descriptions (comma-separated)
ALLOWED_STUDY_DESCRIPTIONS=chest pa,chest ap,chest lateral,cxr

# Worker Settings
CELERY_WORKERS=4
CELERY_MAX_TASKS_PER_CHILD=100
